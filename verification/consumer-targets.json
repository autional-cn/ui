{
  "$description": "消费者副本位置与交付方式。ui/ 是独立 git 仓库，sites/ 是同级目录；CI 里只 checkout ui/ 时该检查自动跳过。",
  "$note": "交付方式目前是「手工拷贝」：站点自带 packages/tailwind-preset/{tokens.css,index.js,index.d.ts}，且不声明 @autional-cn/* 依赖。副本由 pnpm sync:consumers 生成。",
  "$modes": {
    "targets": "按 :root 变量逐条比对——能给出「缺哪些/哪些值不同」的可读诊断，用于 tokens.css",
    "byteTargets": "直接比 sha256——非 CSS 产物没有 :root 可比，且它们是纯生成物，逐字节一致才是正确判据",
    "bootstrap": "仓库里没有 packages/tailwind-preset 的站点（5 个 Astro 站点）。它们此前完全不消费设计系统，而是在 tailwind.config.cjs 里内联整套色阶。此处声明如何为它们建立交付路径：profile 指定该站点应加载的 profile 样式表（docs/developer 有；web 用 marketing，其覆盖为 0）。"
  },
  "targets": [
    "../sites/*/packages/tailwind-preset/tokens.css"
  ],
  "byteTargets": [
    {
      "auth": "packages/tailwind-preset/index.js",
      "copy": "../sites/*/packages/tailwind-preset/index.js"
    },
    {
      "auth": "packages/tailwind-preset/index.d.ts",
      "copy": "../sites/*/packages/tailwind-preset/index.d.ts"
    },
    {
      "auth": "packages/tokens/dist/antd-theme.mjs",
      "copy": "../sites/*/packages/tailwind-preset/antd-theme.mjs"
    },
    {
      "auth": "packages/tokens/dist/antd-theme.d.mts",
      "copy": "../sites/*/packages/tailwind-preset/antd-theme.d.mts"
    },
    {
      "auth": "shared/ui/ErrorBoundary.tsx",
      "copy": "../sites/*/packages/ui/src/molecules/ErrorBoundary.tsx"
    }
  ],
  "bootstrap": [
    {
      "site": "docs",
      "profile": "docs"
    },
    {
      "site": "developer",
      "profile": "developer"
    },
    {
      "site": "web",
      "profile": null
    },
    {
      "site": "wiki",
      "profile": "docs"
    },
    {
      "site": "reference",
      "profile": "docs"
    }
  ],
  "publicDirs": {
    "$note": "各站点静态资源目录。9 个 SPA 站在 apps/<app>/public，5 个 Astro 站在根 public。图标套件下发到这里。",
    "admin": "apps/admin-console/public",
    "auth": "apps/auth-pages/public",
    "authenticator": "apps/authenticator-app/public",
    "brand": "apps/brand-portal/public",
    "developer": "public",
    "docs": "public",
    "platform": "apps/platform-console/public",
    "reference": "public",
    "security": "apps/security-dashboard/public",
    "status": "apps/status-page/public",
    "trust": "apps/trust-center/public",
    "user": "apps/end-user-portal/public",
    "web": "public",
    "wiki": "public"
  },
  "themeColors": {
    "$note": "每站 theme-color 的**单一来源**。theme-color 由浏览器消费、必须写字面量（写 var() 会被直接忽略），所以它无法直接引用 CSS 变量——这里的做法是：在这里声明一次（值可以是 {令牌路径} 引用），sync-consumers 解析后写进 site.webmanifest，check-icons 闸门再断言各站 <meta> 与之一致。三处非默认值是刻意的平台差异，不是心情：authenticator 是纯黑底暗色应用、user 是 indigo 品牌体系、web 是白底营销站。",
    "default": "{color.primary.700}",
    "authenticator": "#0a0a0a",
    "user": "#4f46e5",
    "web": "{color.neutral.0}"
  },
  "iconSources": {
    "$note": "图标套件的权威来源 → 站点 public/ 内的目标名。sync-consumers 按此下发，check-icons 按此做逐字节漂移校验。favicon 在修复前**完全没有交付通道**（U65④）：14 站各自手工放置，实测只有 3 站有完整图标组。",
    "files": [
      {
        "from": "assets/favicon_io/favicon.ico",
        "to": "favicon.ico"
      },
      {
        "from": "assets/favicon_io/favicon-16x16.png",
        "to": "favicon-16x16.png"
      },
      {
        "from": "assets/favicon_io/favicon-32x32.png",
        "to": "favicon-32x32.png"
      },
      {
        "from": "assets/favicon/png/favicon-48x48.png",
        "to": "favicon-48x48.png"
      },
      {
        "from": "assets/favicon_io/apple-touch-icon.png",
        "to": "apple-touch-icon.png"
      },
      {
        "from": "assets/favicon_io/android-chrome-192x192.png",
        "to": "android-chrome-192x192.png"
      },
      {
        "from": "assets/favicon_io/android-chrome-512x512.png",
        "to": "android-chrome-512x512.png"
      },
      {
        "from": "assets/logo/favicon.svg",
        "to": "favicon.svg"
      }
    ]
  }
}
