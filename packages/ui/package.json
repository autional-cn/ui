{
  "name": "@autional-cn/ui",
  "version": "0.1.0-rc.27",
  "description": "Autional shared React component library (atoms + molecules) — the canonical home of the component layer",
  "license": "AGPL-3.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./antd": {
      "types": "./src/antd/index.ts",
      "default": "./src/antd/index.ts"
    },
    "./rhf": {
      "types": "./src/rhf/index.ts",
      "default": "./src/rhf/index.ts"
    },
    "./test-setup": {
      "types": "./src/test-setup.ts",
      "default": "./src/test-setup.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/test",
    "!src/__tests__",
    "!src/**/__tests__"
  ],
  "sideEffects": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@autional-cn/tokens": ">=0.1.0-rc",
    "antd": ">=6.0.0",
    "dayjs": ">=1.11.0",
    "i18next": ">=26.0.0",
    "react-hook-form": ">=7.0.0",
    "react-router": ">=7.0.0",
    "lucide-react": ">=0.500.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@autional-cn/tokens": "0.1.0-rc.5",
    "antd": "6.5.0",
    "dayjs": "1.11.20",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "i18next": "26.0.10",
    "jsdom": "29.1.1",
    "lucide-react": "0.509.0",
    "react-hook-form": "7.78.0",
    "react-router": "7.15.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.7",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  }
}
