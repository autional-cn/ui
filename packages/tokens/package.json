{
  "name": "@autional/tokens",
  "version": "0.1.0-rc.12",
  "description": "Autional canonical design tokens — CSS variables, Tailwind values, antd theme bridge, chart colors",
  "license": "AGPL-3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tokens.css",
    "primitives.css",
    "profiles",
    "fonts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./primitives.css": "./primitives.css",
    "./profiles/*.css": "./profiles/*.css",
    "./antd-theme": {
      "types": "./dist/antd-theme.d.ts",
      "default": "./dist/antd-theme.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
