          "900": "#4a3500"
        },
        "border-subtle": "{color.primary.100}"
      },
      "shadow": {
        "soft": "0 16px 40px rgba(0, 49, 83, 0.10)",
        "card": "0 20px 60px rgba(3, 20, 37, 0.08)",
