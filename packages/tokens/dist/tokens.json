          "300": "#ffcf40",
          "400": "#ffc71a",
          "500": "#ffbf00",
          "600": "#d69f00",
          "700": "#a67800",
          "800": "#755400",
          "900": "#4a3500"
        },
        "border-subtle": "{color.primary.100}"
      },
      "shadow": {
        "soft": "0 16px 40px rgba(0, 49, 83, 0.10)",
        "card": "0 20px 60px rgba(3, 20, 37, 0.08)",
        "brand": "0 32px 100px rgba(3, 20, 37, 0.12)"
      }
    },
    "developer": {
      "$note": "developer.autional.cn. Same scale family as docs (the developer site historically mirrors docs).",
      "color": {
        "primary": {
          "50": "#e9f3f9",
          "100": "#d1e5f2",
          "200": "#9ec2db",
          "300": "#6a9fbe",
          "400": "#3c779a",
          "500": "#235f84",
          "600": "#124b70",
