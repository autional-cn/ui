{
  "$meta": {
    "name": "Autional Design Tokens",
    "package": "@autional-cn/tokens",
    "version": "0.1.0-rc",
    "spec": 1,
    "description": "Single source of truth for the Autional design system (canonical repo: autional-cn/ui). Edit this file, then run `pnpm gen`. Generated artifacts are committed.",
    "conventions": {
      "reference": "A value of the exact form {a.b.c} references another token. CSS artifacts emit var(--a-b-c); JS artifacts resolve it to the literal value (profile/mode aware).",
      "literal": "Any other string is emitted verbatim (raw CSS syntax such as var(...) with fallbacks is allowed).",
      "metadata": "Keys starting with $ carry notes or emission hints and are never emitted.",
      "naming": "CSS variable name = --{namespace}-{key path joined with '-'}; e.g. core.color.primary.500 -> --color-primary-500, core['font-size'].base -> --font-size-base, core.motion['ease-out'] -> --motion-ease-out."
    }
  },
  "core": {
    "color": {
      "primary": {
        "50": "#e8f1f8",
        "100": "#d1e3f1",
        "200": "#a3c7e3",
        "300": "#75abd5",
        "400": "#478fc7",
        "500": "#235f84",
        "600": "#004565",
        "700": "#003153",
        "800": "#002540",
        "900": "#041d31"
      },
      "sky": {
        "50": "#f2fafd",
        "100": "#eef9fd",
        "200": "#d5f0f9",
        "300": "#bde6f5",
        "400": "#a2dcf0",
        "500": "#87ceeb",
        "600": "#64b4d8",
        "700": "#429bc5",
        "800": "#2d7ca3",
        "900": "#1c5d7e"
      },
      "amber": {
        "50": "#fffcf0",
        "100": "#fff8e6",
        "200": "#ffefb3",
        "300": "#ffe480",
        "400": "#ffd94d",
        "500": "#ffbf00",
        "600": "#d9a300",
        "700": "#b38700",
        "800": "#8c6b00",
        "900": "#664f00"
      },
      "neutral": {
        "0": "#ffffff",
        "50": "#fafbfc",
        "100": "#f7fafd",
        "200": "#eef2f6",
        "300": "#dce3ea",
        "400": "#b0bcc8",
        "500": "#8896a6",
        "600": "#64748b",
        "700": "#475569",
        "800": "#334155",
        "900": "#1e293b"
      },
      "success": "#52c41a",
      "warning": "#faad14",
      "danger": "#ff4d4f",
      "info": "#1890ff",
      "chart": {
        "1": "{color.primary.700}",
        "2": "{color.amber.500}",
        "3": "{color.sky.500}",
        "4": "{color.amber.800}",
        "5": "{color.primary.300}",
        "6": "{color.amber.700}",
        "7": "{color.sky.700}",
        "8": "{color.primary.800}"
      },
      "$chart-note": "Categorical series colors, derived from the primary/sky/amber families only, ordered so adjacent series alternate hue family and lightness. chart-1 = primary-700 (#003153) keeps single-series charts on the brand anchor. Status-like series (healthy/unhealthy, delivered/failed) use semantic colors (success/warning/danger), never chart-N.",
      "method": {
        "get": "{color.primary.600}",
        "post": "{color.success}",
        "put": "{color.amber.600}",
        "patch": "{color.sky.600}",
        "delete": "{color.danger}",
        "head": "{color.neutral.500}"
      },
      "bg-primary": "{color.neutral.50}",
      "bg-surface": "{color.neutral.0}",
      "bg-elevated": "{color.neutral.0}",
      "bg-muted": "#f8fbfe",
      "bg-developer": "#031425",
      "text-primary": "{color.primary.900}",
      "text-secondary": "{color.primary.600}",
      "text-muted": "#64748d",
      "text-inverse": "#f8fbfe",
      "border": "{color.border-subtle}",
      "border-subtle": "{color.primary.200}",
      "border-strong": "#9ec2db",
      "brand-base": "{color.primary.700}",
      "brand-hover-base": "{color.primary.600}",
      "brand-dark": "{color.sky.500}",
      "brand-dark-hover": "{color.sky.400}",
      "on-brand-base": "#ffffff",
      "on-brand": "{color.on-brand-base}",
      "on-brand-dark": "#0a0f1a",
      "brand": "{color.brand-base}",
      "brand-hover": "{color.brand-hover-base}",
      "brand-soft": "{color.sky.300}",
      "brand-active": "{color.primary.800}",
      "accent": "{color.amber.500}"
    },
    "font": {
      "sans": [
        "Inter",
        "-apple-system",
        "Segoe UI",
        "PingFang SC",
        "Microsoft YaHei",
        "Noto Sans CJK SC",
        "sans-serif"
      ],
      "serif": [
        "Source Han Serif SC",
        "Noto Serif SC",
        "serif"
      ],
      "mono": [
        "JetBrains Mono",
        "Fira Code",
        "Consolas",
        "monospace"
      ]
    },
    "$font-note": "Latin: self-hosted Inter (@fontsource). CJK: system stack only (PingFang SC / Microsoft YaHei / Noto Sans CJK SC) — CJK webfonts exceed 2MB and are not acceptable for LCP on Vercel + mainland China.",
    "font-size": {
      "xs": {
        "size": "12px",
        "lineHeight": "16px"
      },
      "sm": {
        "size": "14px",
        "lineHeight": "20px"
      },
      "base": {
        "size": "16px",
        "lineHeight": "24px"
      },
      "lg": {
        "size": "18px",
        "lineHeight": "28px",
        "fontWeight": "500"
      },
      "xl": {
        "size": "20px",
        "lineHeight": "28px",
        "fontWeight": "600"
      },
      "2xl": {
        "size": "24px",
        "lineHeight": "32px",
        "fontWeight": "700"
      },
      "3xl": {
        "size": "30px",
        "lineHeight": "36px",
        "fontWeight": "700"
      },
      "display-xl": {
        "size": "48px",
        "lineHeight": "1.16",
        "fontWeight": "800",
        "letterSpacing": "-0.02em"
      },
      "display-lg": {
        "size": "40px",
        "lineHeight": "1.2",
        "fontWeight": "800",
        "letterSpacing": "-0.015em"
      },
      "heading-lg": {
        "size": "30px",
        "lineHeight": "1.35",
        "fontWeight": "700",
        "letterSpacing": "-0.01em"
      },
      "heading-md": {
        "size": "22px",
        "lineHeight": "1.45",
        "fontWeight": "700",
        "letterSpacing": "0"
      },
      "body-lg": {
        "size": "18px",
        "lineHeight": "1.75"
      },
      "body-md": {
        "size": "16px",
        "lineHeight": "1.75"
      },
      "body-sm": {
        "size": "14px",
        "lineHeight": "1.6"
      },
      "label-md": {
        "size": "14px",
        "lineHeight": "1.43",
        "fontWeight": "600"
      },
      "label-caps": {
        "size": "12px",
        "lineHeight": "1.35",
        "fontWeight": "600",
        "letterSpacing": "0.12em"
      },
      "code-md": {
        "size": "14px",
        "lineHeight": "1.75"
      }
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "radius": {
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "28px",
      "xxl": "32px",
      "full": "9999px"
    },
    "shadow": {
      "soft": "0 8px 20px rgba(0, 49, 83, 0.08)",
      "card": "0 12px 36px rgba(0, 49, 83, 0.10)",
      "brand": "0 24px 80px rgba(0, 49, 83, 0.14)"
    },
    "motion": {
      "duration-instant": "100ms",
      "duration-fast": "150ms",
      "duration-base": "200ms",
      "duration-slow": "300ms",
      "duration-slower": "500ms",
      "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "focus": {
      "ring-width": "2px",
      "ring-offset": "2px",
      "ring-color": "{color.primary.500}"
    },
    "z": {
      "base": "0",
      "dropdown": "1000",
      "sticky": "1020",
      "fixed": "1030",
      "modal-backdrop": "1040",
      "modal": "1050",
      "popover": "1060",
      "toast": "1070",
      "tooltip": "1080"
    },
    "layout": {
      "max-width": "1280px",
      "prose-width": "768px",
      "breakpoint-sm": "640px",
      "breakpoint-md": "768px",
      "breakpoint-lg": "1024px",
      "breakpoint-xl": "1280px",
      "breakpoint-2xl": "1536px"
    },
    "a11y": {
      "touch-target": "44px"
    },
    "image": {
      "brand-radial": "radial-gradient(circle at top, rgba(135, 206, 235, 0.22), transparent 44%)",
      "brand-grid": "linear-gradient(rgba(0, 49, 83, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 49, 83, 0.08) 1px, transparent 1px)",
      "page-light": "radial-gradient(circle at top left, rgba(135, 206, 235, 0.18), transparent 28%), radial-gradient(circle at top right, rgba(255, 191, 0, 0.10), transparent 22%), linear-gradient(180deg, #f8fbfe 0%, #ffffff 26%, #f7fafd 100%)",
      "page-dark": "radial-gradient(circle at top left, rgba(135, 206, 235, 0.12), transparent 28%), radial-gradient(circle at top right, rgba(255, 191, 0, 0.08), transparent 20%), linear-gradient(180deg, #041d31 0%, #031425 45%, #020b14 100%)"
    },
    "$image-note": "brand-radial/brand-grid are decorative section backdrops. page-light/page-dark are the full-page body wash applied by @autional-cn/tokens/primitives.css on content sites; the alpha values converge the former website (0.16) and docs/developer (0.18) variants onto one canonical stop."
  },
  "modes": {
    "dark": {
      "$note": "Emitted as `.dark, [data-theme=\"dark\"]`. Applies on top of any profile.",
      "$colorScheme": "dark",
      "color": {
        "neutral": {
          "0": "#0a0f1a",
          "50": "#0f1a2e",
          "100": "#142238",
          "200": "#1a2a42",
          "300": "#1f3350",
          "400": "#2a4060",
          "500": "#4a6585",
          "600": "#6b8caa",
          "700": "#8fb0cc",
          "800": "#b5d0e6",
          "900": "#e2edf5"
        },
        "bg-primary": "{color.primary.900}",
        "bg-surface": "#0a2940",
        "bg-elevated": "#0f3348",
        "bg-muted": "#0a1f30",
        "text-primary": "#f8fbfe",
        "text-secondary": "#87ceeb",
        "text-muted": "#64748d",
        "border-subtle": "#1a4a65",
        "border-strong": "#2d6a85",
        "border": "{color.border-strong}",
        "brand": "{color.brand-dark}",
        "brand-hover": "{color.brand-dark-hover}",
        "on-brand": "{color.on-brand-dark}",
        "brand-soft": "{color.sky.700}"
      },
      "focus": {
        "ring-color": "{color.sky.500}"
      }
    }
  },
  "variants": {
    "portal": {
      "$note": "Shared light surface for the end-user portal family (e.g. trust portal).",
      "color": {
        "bg-primary": "{color.neutral.0}",
        "brand": "var(--color-brand-base, var(--color-primary-600))",
        "brand-hover": "var(--color-brand-hover-base, var(--color-primary-500))",
        "brand-soft": "{color.sky.400}"
      }
    },
    "auth": {
      "$note": "Auth pages family.",
      "color": {
        "bg-primary": "{color.neutral.0}",
        "brand": "var(--color-brand-base, var(--color-primary-600))",
        "brand-hover": "var(--color-brand-hover-base, var(--color-primary-500))"
      }
    },
    "authenticator": {
      "$note": "Authenticator app — deliberately dark-first, pure black. Wins over `.dark` when both apply.",
      "$colorScheme": "dark",
      "color": {
        "bg-primary": "#0a0a0a",
        "bg-surface": "#141414",
        "bg-elevated": "#1f1f1f",
        "text-primary": "#f5f5f5",
        "text-secondary": "#a3a3a3",
        "border-subtle": "#2a2a2a",
        "border-strong": "#3a3a3a",
        "brand": "{color.primary.500}",
        "brand-hover": "{color.primary.400}"
      },
      "focus": {
        "ring-color": "{color.sky.500}"
      }
    },
    "auth-tenant": {
      "$kind": "runtime",
      "$note": "Runtime variant, no stylesheet emitted. Auth pages inject a tenant brand color (derived with OKLab + WCAG contrast, see auth-pages src/lib/brand-color.ts) into these variables at page load; all brand aliases above follow automatically.",
      "inject": [
        "--color-brand-base",
        "--color-brand-hover-base",
        "--color-on-brand-base"
      ]
    }
  },
  "profiles": {
    "console": {
      "$note": "The 8 SPA portals (admin/auth/user/security/status/trust/platform/authenticator) and the shared react UI package. Extends core without overrides — this IS the canonical baseline."
    },
    "marketing": {
      "$note": "www (marketing site). Extends core without token overrides (primary/amber re-converge to core; the legacy website scale is deprecated). Distinctive: full dark-mode support via darkMode: 'class', brand-radial / brand-grid imagery (core.image), typography plugin."
    },
    "docs": {
      "$note": "docs.autional.cn, reference.autional.cn, wiki.autional.cn. Slightly cooler, deeper primary/sky scales and larger soft shadows.",
      "color": {
        "primary": {
